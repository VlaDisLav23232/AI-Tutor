# Postgres. Locally: `npx prisma dev --name nmt --detach` prints a URL. In production: Neon (pooled URL).
DATABASE_URL=""

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google and https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# "true" shows a demo login button for local testing without Google. Ignored in production builds.
AUTH_DEV_LOGIN="true"

# AI provider: "anthropic" (default), "gemini" or "groq". Only the active provider's key is needed.
# Without a key the app works, but AI explanations, hints, chat and LLM-generated tasks are disabled
# (stress and foreign-word tasks still generate).
AI_PROVIDER="anthropic"

# Claude API key (console.anthropic.com). Models: Sonnet for explanations/chat/generation, Haiku for checks.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL_MAIN="claude-sonnet-5-5"
# ANTHROPIC_MODEL_FAST="claude-haiku-4-5"

# Gemini API key (aistudio.google.com/apikey).
GEMINI_API_KEY=""
# GEMINI_MODEL_MAIN="gemini-3.8-flash"        # or "gemini-3.1-pro-preview" for harder reasoning (pricier)
# GEMINI_MODEL_FAST="gemini-3.5-flash-lite"
# Tried in order when the main model is overloaded or out of quota (comma-separated); "" disables it.
# GEMINI_MODEL_MAIN_FALLBACK="gemini-3.6-flash"

# Groq API key (console.groq.com/keys). Free tier: 30 requests/min, 1,000/day, 8K tokens/min, 200K tokens/day.
GROQ_API_KEY=""
# GROQ_MODEL_MAIN="openai/gpt-oss-120b"
# GROQ_MODEL_FAST="openai/gpt-oss-20b"
# GROQ_MAX_TOKENS=""                         # optional output cap; too low cuts off explanations


# Hard cap on total AI API spend in USD (all providers), tracked in the database. AI features switch off when reached.
AI_BUDGET_USD="1.50"

# Optional: exam time limit in minutes (check the official 2026 value).
# EXAM_MINUTES=60
